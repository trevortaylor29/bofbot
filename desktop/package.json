{
  "name": "bofbot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BofBot desktop — local UI + Python worker; auth/plan via production API (see src/config.ts)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bofbot/tiktoked.git"
  },
  "main": "src/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:pipeline": "node scripts/prepare-pipeline.cjs",
    "build:win": "npm run build:renderer && npm run build:pipeline && electron-builder --win",
    "start": "electron ."
  },
  "build": {
    "appId": "com.bofbot.desktop",
    "productName": "BofBot",
    "copyright": "Copyright © BofBot",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!src/renderer/**/*",
      "!pyinstaller/**/*",
      "!scripts/**/*",
      "!build/**/*",
      "!release/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme.md.gz}",
      "!**/.env",
      "!**/.env.local",
      "!**/.env.example",
      "!**/.env.*",
      "!**/.git",
      "!**/.git/**",
      "!../web",
      "!../web/**",
      "!../web/node_modules",
      "!../web/node_modules/**",
      "!../deploy",
      "!../deploy/**"
    ],
    "extraResources": [
      {
        "from": "build/pipeline-staging",
        "to": "bofbot-pipeline",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon_256.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BofBot",
      "installerIcon": "icon_256.ico",
      "uninstallerIcon": "icon_256.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "bofbot",
      "repo": "tiktoked",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tree-kill": "^1.2.2"
  }
}
