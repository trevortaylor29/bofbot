# Postgres — signup, dashboard (optional for upload flow)
DATABASE_URL=postgresql://user:password@localhost:5432/bofbot

# Optional: Redis + BullMQ for DB-backed background jobs only
# REDIS_URL=redis://localhost:6379

# Optional: guest user id for no-login mode
# ANONYMOUS_USER_ID=anonymous

# NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Local upload + FFmpeg pipeline (no S3) ---
# Next.js writes/reads under this directory (default: web/.data/media)
# LOCAL_MEDIA_ROOT=

# Python worker must use the SAME absolute path (either name works on the worker):
# BOFBOT_MEDIA_ROOT=X:/path/to/repo/web/.data/media
# TIKTOKED_MEDIA_ROOT=(legacy alias, same value)
#
# FastAPI (required for Process videos)
# WORKER_URL=http://127.0.0.1:8000
# WORKER_API_KEY=

# --- Cloudflare R2 (production / Vercel) ---
# When all are set, batch creation returns presigned PUT URLs so the browser
# uploads videos directly to R2 (no file bytes through Next.js — avoids payload limits).
# Process-status returns presigned GET URLs for each output; zip route streams a zip
# built from R2 objects under out/{batchId}/ (ListObjects + GetObject).
# Add a CORS policy on the bucket: allow PUT + Content-Type from your app origin.
# R2_BUCKET=bofbot
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
