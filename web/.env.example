# Copy to .env.local and fill in (never commit real secrets).

# Neon: Project → Connection string (use pooled + sslmode=require if offered)
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Optional: force session cookie Secure flag (default: true in production only). Use false if needed for local `next start` over http.
# AUTH_COOKIE_SECURE=false
# Used for Stripe success/cancel redirects if AUTH_URL is unset
NEXT_PUBLIC_APP_URL=http://localhost:3000

WORKER_URL=http://127.0.0.1:8000
WORKER_API_KEY=

# Stripe test mode: Dashboard → Developers → API keys (sk_test_...)
STRIPE_SECRET_KEY=
# After `npm run stripe:seed` (test mode):
STRIPE_PRICE_STARTER=
# Must equal the Price ID from Stripe Dashboard (Products → price), same mode as STRIPE_SECRET_KEY (test vs live).
STRIPE_PRICE_PRO=
# Webhook signing secret (`whsec_...`) from Dashboard → Webhooks, or `stripe listen`.
# Endpoint URL: https://<your-host>/api/billing/webhook (or /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Enable Customer portal: Stripe Dashboard → Settings → Customer portal

STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (https://resend.com) — contact form at /contact
RESEND_API_KEY=
# Inbox that receives contact form submissions (your email)
CONTACT_EMAIL=
# Optional. Defaults to Resend onboarding sender (dev only). Use a verified domain in production, e.g. BofBot <hello@yourdomain.com>
# RESEND_FROM_EMAIL=
