# Copy to /opt/bofbot/.env on the droplet (never commit real secrets).

# Cloudflare R2 (required on the droplet for production)
R2_BUCKET=bofbot
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Require this header from Vercel: Authorization: Bearer <WORKER_API_KEY>
WORKER_API_KEY=

# Path to config.json (fonts paths inside are relative to /opt/bofbot)
TIKTOKED_CONFIG=/opt/bofbot/config.json

# Optional
# WORKER_FFMPEG_TIMEOUT_SEC=120

# Local disk mode only (omit R2_* to use these — not typical on DO)
# BOFBOT_MEDIA_ROOT=/opt/bofbot/media
